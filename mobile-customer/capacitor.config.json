{
  "appId": "kz.qazgost.client",
  "appName": "QazGost",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0f0d1a"
  },
  "ios": {
    "contentInset": "never",
    "scheme": "App",
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0f0d1a"
  }
}