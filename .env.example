# ─────────────────────────────────────────────
# QazGost AI — Environment Variables
# ─────────────────────────────────────────────
# Copy to .env and fill in values:
#   cp .env.example .env

# PostgreSQL (required by the Go backend; Railway sets it automatically)
# Local example: DATABASE_URL=postgres://postgres:postgres@localhost:5432/qazgost?sslmode=disable
DATABASE_URL=

# JWT Secret (change in production!)
JWT_SECRET=change-me-to-random-string

# OpenAI API Key (optional — system works without it via fallback)
OPENAI_API_KEY=

# Roboflow API Key (for downloading training dataset)
ROBOFLOW_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Service (on Railway: the internal URL of the separate ai-service, e.g. http://ai-service.railway.internal:8001)
AI_SERVICE_URL=http://localhost:8001

# Extra allowed CORS origins, comma-separated (production web domain is allowed by default)
CORS_ORIGINS=
