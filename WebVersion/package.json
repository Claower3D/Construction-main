{
  "name": "qazgost-ai-web",
  "version": "2.0.0",
  "description": "QazGost AI - Smart construction estimation and defect detection platform",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": ["<rootDir>/__tests__"],
    "moduleFileExtensions": ["js"],
    "testMatch": ["**/*.test.js"],
    "verbose": true
  }
}
