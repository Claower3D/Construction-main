# ==================================
# QAZGOST AI Backend Configuration
# ==================================
# Скопируйте этот файл в .env и заполните своими данными:
#   cp .env.example .env

# Server
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/qazgost_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qazgost_db
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# Redis (Caching, Sessions, Pub/Sub)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication — ОБЯЗАТЕЛЬНО смените в продакшене!
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Twilio (OTP via WhatsApp/SMS)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:5500

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Email (Nodemailer - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=QAZGOST AI <noreply@qazgost.kz>

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Backend Public URL (для webhook-ов)
BACKEND_PUBLIC_URL=http://127.0.0.1:3001

# Currency Rates
USD_TO_KZT_RATE=480

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:8080

# Telegram Bot
# Get token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# API key for bot→backend communication (generate: openssl rand -hex 32)
BOT_API_KEY=
