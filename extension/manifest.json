{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDescription__",
  "default_locale": "ru",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "notifications",
    "sidePanel",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:8001/*",
    "https://*.olx.kz/*",
    "https://*.krisha.kz/*",
    "https://*.satu.kz/*",
    "https://*.kolesa.kz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.olx.kz/*",
        "https://*.krisha.kz/*",
        "https://*.satu.kz/*",
        "https://*.kolesa.kz/*"
      ],
      "js": ["content/overlay.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_page": "options/options.html"
}
