{
  "appId": "kz.qazgost.manager",
  "appName": "QazGost CRM",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "scheme": "App",
    "limitsNavigationsToAppBoundDomains": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0b0a1c"
  }
}