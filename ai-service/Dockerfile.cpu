# ═══════════════════════════════════════════════════════════════════
# QAZGOST AI Service — CPU-only Dockerfile v3
# Для Railway / CI / серверов без GPU. Детекция дефектов (YOLO) работает на CPU,
# модель models/defect_*.pt запекается в образ.
#
#   docker build -f Dockerfile.cpu -t qazgost-ai-cpu .
#   docker run -p 8001:8001 qazgost-ai-cpu
# Railway: сервис с root = ai-service, Dockerfile Path = Dockerfile.cpu; порт берётся из $PORT.
# ═══════════════════════════════════════════════════════════════════

# ── Build stage: всё ставится в venv /opt/venv (тот же базовый образ → пути совпадают) ──
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# CPU-only torch первым (иначе ultralytics притянет CUDA-сборку с PyPI, ~2.5 ГБ)
RUN pip install --upgrade pip && \
    pip install "torch==2.5.1" "torchvision==0.20.1" --index-url https://download.pytorch.org/whl/cpu

WORKDIR /build
COPY requirements-cpu.txt .
RUN pip install -r requirements-cpu.txt

# ── Runtime stage ─────────────────────────────────────────────────
FROM python:3.11-slim

# libgl1/libglib2.0-0 — OpenCV (ultralytics ставит opencv-python), libgomp1 — torch/open3d,
# ffmpeg — pydub (распознавание речи), fonts-dejavu-core — кириллица в PDF и на аннотациях
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        ffmpeg \
        fonts-dejavu-core \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin app

WORKDIR /app

# Код и обученные веса детектора дефектов (.dockerignore пропускает только models/defect_*.pt)
COPY app/ ./app/
COPY models/ ./models/

# Каталоги для загрузок, результатов, логов и SQLite со сметами (смонтируйте том на /app/db)
RUN mkdir -p /app/uploads /app/results /app/logs /app/db /app/data \
    && chown -R app:app /app

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEVICE=cpu \
    HOST=0.0.0.0 \
    PORT=8001 \
    CORS_DEV=false \
    ESTIMATES_DB_PATH=/app/db/estimates.db \
    OLLAMA_HOST=http://ollama:11434 \
    YOLO_CONFIG_DIR=/tmp/ultralytics \
    MPLCONFIGDIR=/tmp/matplotlib \
    LOG_LEVEL=INFO

USER app

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT:-8001}/health" || exit 1

EXPOSE 8001

# sh -c — чтобы подставить $PORT (Railway задаёт его сам); exec — корректные сигналы
CMD ["sh", "-c", "exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8001} --workers 1"]
