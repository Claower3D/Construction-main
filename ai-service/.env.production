# ═══════════════════════════════════════════════════════════════════
# QAZGOST AI — Production Deployment Configuration
#
# This file contains production-ready settings.
# Copy to .env and customize for your environment.
# ═══════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────
APP_NAME=QAZGOST AI Service
APP_VERSION=3.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# ─── GPU & Device ─────────────────────────────────────────────────
DEVICE=auto
# auto = use GPU if available, fallback to CPU

# ─── Ollama (VLM Backend) ────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
QWEN_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=180

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["https://app.qazgost.kz","http://localhost:3000","http://localhost:5173"]

# ─── Ports (host mapping) ────────────────────────────────────────
AI_PORT=8001
OLLAMA_PORT=11434

# ─── Monitoring ───────────────────────────────────────────────────
# Enable with: docker compose --profile monitoring up -d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=qazgost2026
PROMETHEUS_RETENTION=30d

# ─── Security ────────────────────────────────────────────────────
# API_KEY=your-secret-api-key-here
# RATE_LIMIT_PER_MINUTE=30

# ─── Storage ──────────────────────────────────────────────────────
# SQLite database for estimates
ESTIMATES_DB_PATH=data/estimates.db

# ─── Regional Settings ───────────────────────────────────────────
DEFAULT_REGION=almaty
# Supported: almaty, astana, shymkent, aktau, atyrau, karaganda
