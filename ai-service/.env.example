# ═══════════════════════════════════════════════════════════════════
# QAZGOST AI Service — Environment Configuration v2
# Copy to .env and configure
# ═══════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
APP_NAME=QAZGOST AI Service
APP_VERSION=2.0.0
DEBUG=false

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
WORKERS=1

# Docker Compose port mapping
AI_PORT=8001
OLLAMA_PORT=11434

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]

# ── Device ─────────────────────────────────────────────────────────
# Options: auto, cuda, cpu, mps (Apple Silicon)
DEVICE=auto
HALF_PRECISION=true

# ── Models ─────────────────────────────────────────────────────────
MODEL_DIR=./models
MAX_IMAGE_SIZE=4096
DEFAULT_CONFIDENCE=0.25
DEFAULT_IOU=0.45

# ── Ollama (Qwen2.5-VL backend) ───────────────────────────────────
OLLAMA_HOST=http://localhost:11434
QWEN_MODEL=qwen2.5vl:7b
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# ── LLM Integration (optional, for cloud fallback) ────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=gpt-4-turbo-preview

# ── Storage ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
MAX_UPLOAD_SIZE=52428800

# ── Cache ──────────────────────────────────────────────────────────
ENABLE_CACHE=true
CACHE_TTL=3600

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Dataset ────────────────────────────────────────────────────────
DATASET_PATH=./data

# ── Telegram Auth ──────────────────────────────────────────────────
# Get bot token from @BotFather, set domain via /setdomain
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_NAME=QazGostBot
# Bot URLs (for bot.py)
AI_SERVICE_URL=http://localhost:8001
BACKEND_URL=http://localhost:3001
WEB_APP_URL=https://qazgost.kz
# API key for bot→backend communication (must match backend BOT_API_KEY)
# BOT_API_KEY=

# ── Firebase (for Telegram custom token) ──────────────────────────
# Path to Firebase service account JSON (optional)
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# ── Gemini AI Chat (for smart bot responses) ──────────────────────
# API key for Google Gemini (used in bot.py for smart chat)
# GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Security (production only) ────────────────────────────────────
# API_KEY=your-api-key-here
# JWT_SECRET=your-jwt-secret-here
